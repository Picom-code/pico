{
  "name": "pico-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "bun mock/dev.ts",
    "dev:mock:ready": "bun mock/dev.ts --state ready",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mock",
    "preview:mock": "bun mock/mock-engine.ts --static dist --port 7879"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}

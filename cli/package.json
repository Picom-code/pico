{
  "name": "pico-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pico terminal app — talks to the Pico engine over HTTP+SSE",
  "bin": { "pico": "src/main.ts" },
  "scripts": {
    "dev": "bun src/main.ts",
    "mock": "bun test/mock-engine.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --compile --minify --sourcemap=none --outfile dist/pico",
    "build:all": "bun scripts/build-all.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Splash + the engine-served web app: window dragging only (data-tauri-drag-region).",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
